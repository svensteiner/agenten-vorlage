# Create these as separate files in deploy/public/secrets/.
# The directory is ignored by Git. Generate random values with a secret manager.
#
# csrf_secret                 (at least 32 random bytes)
# identity_secret             (at least 32 random bytes)
# provider_credentials.json   {"deepseek_api_key":"..."}
# oidc_client_secret          (OIDC client secret)
# session_cookie_secret       (exactly 32 raw random bytes; not Base64 text)
