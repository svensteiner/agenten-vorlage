# Non-secret deployment settings. Copy to a deployment-only environment file.
# Every image reference used in production must include an immutable sha256 digest.
# The app image is built and pushed separately, then deployed by its immutable
# registry digest. A tag is not accepted by docker-compose.production.yml.
AGENTKIT_APP_IMAGE=registry.example.com/company/agentkit-public@sha256:REPLACE_WITH_APP_IMAGE_DIGEST
AGENTKIT_PYTHON_BASE_IMAGE=python:3.12-slim@sha256:REPLACE_WITH_VERIFIED_DIGEST
AGENTKIT_OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:v7.15.4@sha256:REPLACE_WITH_VERIFIED_DIGEST
AGENTKIT_CADDY_IMAGE=caddy:2.11.4-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST

AGENTKIT_PUBLIC_HOST=agents.example.com
AGENTKIT_PUBLIC_ORIGIN=https://agents.example.com
# The app alone is attached to the dedicated egress network. Allow
# api.github.com for public previews; DeepSeek is opt-in and additionally
# requires a host/firewall allowlist for api.deepseek.com.
AGENTKIT_PUBLIC_BACKENDS=demo
AGENTKIT_TENANT_ID=company
AGENTKIT_TRUSTED_PROXY_CIDRS=172.31.0.0/24

AGENTKIT_AUTH_ISSUER=https://identity.example.com/realms/company
AGENTKIT_AUTH_CLIENT_ID=agentkit-public
AGENTKIT_AUTH_ALLOWED_DOMAIN=example.com
# Users must also receive one or more application roles named exactly
# viewer, member, reviewer or tenant_admin in the OIDC groups claim.
AGENTKIT_AUTH_ALLOWED_GROUP=member

# Bounded public runtime limits. Tune these for the host capacity and keep them
# in the deployment file so every production change is reviewable.
AGENTKIT_MAX_REQUESTS_PER_USER_PER_MINUTE=120
AGENTKIT_MAX_REQUESTS_PER_TENANT_PER_MINUTE=1000
AGENTKIT_MAX_CACHED_RUNTIMES=128
AGENTKIT_MAX_USERS_PER_TENANT=100
AGENTKIT_STORAGE_QUOTA_BYTES=268435456
AGENTKIT_STORAGE_QUOTA_FILES=10000
AGENTKIT_MAX_JOBS_PER_USER_PER_HOUR=20
AGENTKIT_MAX_JOBS_PER_TENANT_PER_HOUR=200
AGENTKIT_MAX_CONCURRENT_JOBS=4
AGENTKIT_MAX_ACTIVE_JOBS_PER_USER=2
AGENTKIT_MAX_HTTP_WORKERS=32
AGENTKIT_DRAIN_TIMEOUT_SECONDS=30
AGENTKIT_AUDIT_MAX_BYTES=8388608
