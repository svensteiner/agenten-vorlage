{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "tool", "arguments", "rationale", "report"],
  "properties": {
    "kind": {"type": "string", "enum": ["proposal", "final"]},
    "tool": {"type": "string", "enum": ["none", "write_file", "edit_file", "run_pytest"]},
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content", "old_text", "new_text"],
      "properties": {
        "path": {"type": "string", "maxLength": 500},
        "content": {"type": "string", "maxLength": 200000},
        "old_text": {"type": "string", "maxLength": 50000},
        "new_text": {"type": "string", "maxLength": 50000}
      }
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "artifacts", "evidence", "next_actions"],
      "properties": {
        "status": {"type": "string", "enum": ["success", "needs_revision", "blocked"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 12000},
        "artifacts": {"type": "array", "maxItems": 40, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "evidence": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "next_actions": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
      }
    }
  }
}
