[Unit]
Description=AI Studio SQLite backup
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/aistudio
EnvironmentFile=-/opt/aistudio/.env
ExecStart=/opt/aistudio/scripts/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelLogs=true
PrivateDevices=true
ReadWritePaths=/opt/aistudio/data
UMask=0077
LimitCORE=0
CapabilityBoundingSet=
AmbientCapabilities=
