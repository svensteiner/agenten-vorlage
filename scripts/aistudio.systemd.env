# Loaded AFTER .env by aistudio.service. systemd: a later EnvironmentFile
# wins; Environment= cannot override EnvironmentFile even if listed later.
# A leftover development .env (laptop, Docker) must not open demo-seed,
# development defaults, or bind 0.0.0.0 under the production unit.
AISTUDIO_ENV=production
AISTUDIO_HOST=127.0.0.1
AISTUDIO_ALLOW_DEMO_SEED=false
