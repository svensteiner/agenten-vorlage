{
  "schema_version": 1,
  "decision_values": ["passed", "remediate", "stopped"],
  "criteria": [
    {
      "id": "sourced_totals",
      "metric": "share_of_reported_totals_with_source_period_and_reconciliation",
      "operator": "equals",
      "target": 1.0,
      "display_target": "100%",
      "evidence_required": ["source_file", "period", "mapped_accounts", "formula", "reconciliation_result"]
    },
    {
      "id": "draft_latency",
      "metric": "minutes_from_validated_input_to_draft",
      "operator": "less_than",
      "target": 5,
      "unit": "minutes",
      "evidence_required": ["validation_completed_at", "draft_created_at"]
    },
    {
      "id": "repeatable_runs",
      "metric": "consecutive_runs_with_identical_inputs_config_and_kpi_results",
      "operator": "greater_than_or_equal",
      "target": 3,
      "unit": "runs",
      "evidence_required": ["sequence", "run_id", "previous_run_signature", "run_signature", "input_fingerprint", "mapping_version", "calculation_version", "kpi_result_hash"]
    },
    {
      "id": "approval_safety",
      "metric": "external_actions_without_explicit_approval",
      "operator": "equals",
      "target": 0,
      "evidence_required": ["approval_log", "external_action_log", "approval_policy_snapshot", "approval_policy_hash", "external_action_capabilities_enabled"]
    }
  ],
  "overall_rule": "passed only if every criterion is passed"
}
