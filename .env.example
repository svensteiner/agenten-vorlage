# LLM-Betriebsprofil: azure (Standard), onprem, openai oder anthropic
LLM_PROVIDER=azure
# Lokal: development. Azure-Produktion muss explizit production setzen.
APP_ENV=development
DEPLOYMENT_TENANCY=shared

# Azure OpenAI / Microsoft Foundry
# Produktionsbetrieb bevorzugt Managed Identity; dann bleibt der API-Key leer.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_USE_MANAGED_IDENTITY=true
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4.1-nano
AZURE_OPENAI_DEPLOYMENT_SMART=gpt-4.1-mini
AZURE_OPENAI_MODEL_FAMILY=gpt-4.1
# Nur bei Reasoning-Modellen explizit passend zum Modell setzen, z.B. high.
AZURE_OPENAI_REASONING_EFFORT=

# Optional: kundeneigenes OpenAI-kompatibles LLM (z.B. vLLM).
# Remote-Endpunkte brauchen Isolation, HTTPS und eine explizite Host-Freigabe.
ONPREM_LLM_BASE_URL=https://llm.customer.example/v1
ONPREM_LLM_ALLOWED_HOSTS=llm.customer.example
ONPREM_LLM_API_KEY=
ONPREM_LLM_MODEL=local-model
ONPREM_LLM_MODEL_FAST=local-model
ONPREM_LLM_MODEL_SMART=local-model
# Für ein Kunden-LLM zwingend auf isolated setzen:
# DEPLOYMENT_TENANCY=isolated

# Optional statt API-Key: kundeneigene CA und mTLS.
ONPREM_LLM_CA_BUNDLE=
ONPREM_LLM_CLIENT_CERT=
ONPREM_LLM_CLIENT_KEY=

# Direkte öffentliche Provider bleiben nur als Legacy-Option verfügbar.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Benachrichtigungen (NotifyTool)
# Telegram: BotFather → /newbot → Token + Chat-ID ermitteln via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Incoming Webhook: api.slack.com/apps → Incoming Webhooks → Add New
SLACK_WEBHOOK_URL=
