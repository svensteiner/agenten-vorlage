# AI Studio product runtime
AISTUDIO_ENV=development
# Produktion und Entwicklung ohne Angabe: 127.0.0.1. Docker setzt 0.0.0.0 im Container
# und braucht dann ein eigenes AISTUDIO_SECRET (nicht den Demo-Wert).
AISTUDIO_HOST=127.0.0.1
AISTUDIO_PORT=8123
AISTUDIO_DATA=./data
# In Produktion und bei Bind 0.0.0.0: mind. 24 Zeichen, nicht der Demo-Wert
AISTUDIO_SECRET=dev-secret-change-me
AISTUDIO_ALLOW_DEMO_SEED=true
AISTUDIO_ALLOW_REGISTER=true
# Produktion: AISTUDIO_ALLOW_REGISTER=false und ersten Mandanten per
# data/bootstrap.env (install.sh), nicht über diese Datei:
# AISTUDIO_BOOTSTRAP_ORG=Muster GmbH
# AISTUDIO_BOOTSTRAP_EMAIL=admin@muster.example
# AISTUDIO_BOOTSTRAP_PASSWORD=
# AISTUDIO_BOOTSTRAP_NAME=Admin
# AISTUDIO_CORS_ORIGINS=https://studio.example.com
# Produktion: * wird ignoriert (same-origin reicht).
# AISTUDIO_TRUST_PROXY=true
# Hinter nginx: AISTUDIO_TRUST_PROXY=true und AISTUDIO_CORS_ORIGINS auf die öffentliche URL.
# X-Forwarded-For nur von diesen Peers (sonst Rate-Limit-Umgehung):
# AISTUDIO_PROXY_IPS=127.0.0.1,::1
# Sicherung: ./scripts/backup.sh (SQLite + uploads/; Passwort in backup.env neben .env, AES-256)

# --- Sprachmodell (product/llm.py) ---
# Standard: in_boundary — kein Cloud-Aufruf, Antworten extractiv auf der Instanz.
# Die Wissensbasis verlässt den Server nie. Es gehen höchstens Kurzauszüge.
#
# Erste Produktstufe (OpenAI, nur Auszüge):
# AISTUDIO_LLM_PROVIDER=openai
# AISTUDIO_LLM_MODEL=gpt-4o-mini
# AISTUDIO_LLM_API_KEY=
# AISTUDIO_LLM_EGRESS=cloud
#
# Später lokal / dezentral (nichts verlässt die Instanz):
# AISTUDIO_LLM_PROVIDER=decentral
# AISTUDIO_LLM_BASE_URL=http://127.0.0.1:11434/v1
# AISTUDIO_LLM_MODEL=llama3.1
# AISTUDIO_LLM_EGRESS=in_boundary
# AISTUDIO_LLM_IN_BOUNDARY_HOSTS=llm.firma.example
# AISTUDIO_LLM_TIMEOUT=20
# AISTUDIO_LLM_MAX_TOKENS=700
# AISTUDIO_LLM_PER_USER=20
# AISTUDIO_LLM_PER_ORG=60
# AISTUDIO_LLM_PER_USER_DAY=200
# AISTUDIO_LLM_PER_ORG_DAY=800
# AISTUDIO_TOKEN_TTL=43200
# AISTUDIO_MAX_UPLOAD_BYTES=2000000
# AISTUDIO_ORG_MAX_DOCS=500
# AISTUDIO_ORG_MAX_RUNNING=2
# AISTUDIO_JOB_STALE_SECONDS=180
# AISTUDIO_EXPORT_JOBS=2000
# AISTUDIO_EXPORT_AUDIT=5000
# AISTUDIO_AUDIT_RETENTION_DAYS=365
# AISTUDIO_JOB_RETENTION_DAYS=90
# AISTUDIO_HOUSEKEEPING_HOURS=24
# AISTUDIO_METRICS_TOKEN=   # in Produktion Pflicht (install.sh legt einen Wert an)
# Backup-Passwort nicht hier — backup.env neben dieser Datei (install.sh).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
