# API Keys — umbenennen zu .env und ausfüllen
# Mindestens einer der LLM-Keys wird gebraucht

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Benachrichtigungen (NotifyTool)
# Telegram: BotFather → /newbot → Token + Chat-ID ermitteln via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Incoming Webhook: api.slack.com/apps → Incoming Webhooks → Add New
SLACK_WEBHOOK_URL=
