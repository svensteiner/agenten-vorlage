# AI Studio product runtime
AISTUDIO_ENV=development
AISTUDIO_HOST=0.0.0.0
AISTUDIO_PORT=8123
AISTUDIO_DATA=./data
# In Produktion: mind. 24 Zeichen, nicht der Demo-Wert
AISTUDIO_SECRET=dev-secret-change-me
AISTUDIO_ALLOW_DEMO_SEED=true
AISTUDIO_ALLOW_REGISTER=true
# Produktion: AISTUDIO_ALLOW_REGISTER=false und ersten Mandanten per Bootstrap:
# AISTUDIO_BOOTSTRAP_ORG=Muster GmbH
# AISTUDIO_BOOTSTRAP_EMAIL=admin@muster.example
# AISTUDIO_BOOTSTRAP_PASSWORD=
# AISTUDIO_BOOTSTRAP_NAME=Admin
# AISTUDIO_CORS_ORIGINS=https://studio.example.com
# AISTUDIO_TRUST_PROXY=true
# Hinter nginx: AISTUDIO_TRUST_PROXY=true und AISTUDIO_CORS_ORIGINS auf die öffentliche URL.
# Sicherung: ./scripts/backup.sh

# --- Sprachmodell (product/llm.py) ---
# Standard: in_boundary — kein Cloud-Aufruf, Antworten extractiv auf der Instanz.
# Die Wissensbasis verlässt den Server nie. Es gehen höchstens Kurzauszüge.
#
# Erste Produktstufe (OpenAI, nur Auszüge):
# AISTUDIO_LLM_PROVIDER=openai
# AISTUDIO_LLM_MODEL=gpt-4o-mini
# AISTUDIO_LLM_API_KEY=
# AISTUDIO_LLM_EGRESS=cloud
#
# Später lokal / dezentral (nichts verlässt die Instanz):
# AISTUDIO_LLM_PROVIDER=decentral
# AISTUDIO_LLM_BASE_URL=http://127.0.0.1:11434/v1
# AISTUDIO_LLM_MODEL=llama3.1
# AISTUDIO_LLM_EGRESS=in_boundary
# AISTUDIO_LLM_TIMEOUT=20
# AISTUDIO_LLM_PER_USER=20
# AISTUDIO_LLM_PER_ORG=60
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
