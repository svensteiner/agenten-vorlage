+def test_one_completed_gatekeeper_rejection_revises_then_requalifies_and_reruns_real_gates(
+        tmp_path, monkeypatch):
+    import content.news_perspective as perspective
+    from content.tweet_archetypes import TonePreset
+
+    bot, llm, observation, first, revised = _real_quality_retry_bot(
+        tmp_path, monkeypatch, gatekeeper_answers=["rejected", "approved"])
+    monkeypatch.setattr(perspective, "assign_perspective", lambda _obs: {
+        "id": "news-perspective-v1", "arm": "perspective", "observation_hash": "a" * 64})
+    monkeypatch.setattr("content.tweet_archetypes.select_tone_with_instruction",
+                        lambda: (TonePreset.DIRECT, "Direct."))
