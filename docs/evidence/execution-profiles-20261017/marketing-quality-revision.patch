+                return False
+            return (self.attempt_ids <= self.budget._recorded and all(
+                attempt["status"] == "ok" for attempt in self.budget.attempts
+                if attempt["attempt_id"] in self.attempt_ids
+            ))
+
+
+def current_call_slice() -> TaskCallSlice | None:
+    budget = current_budget()
+    return next((frame for frame in reversed(_CALL_SLICES.get())
+                 if frame.budget is budget and not frame.closed), None)
+
+
+@contextmanager
+def task_call_slice(max_calls: int) -> Iterator[TaskCallSlice]:
+    budget = current_budget()
+    if budget is None:
+        raise BudgetExceeded("Local call slice requires an active task budget")
+    frame = TaskCallSlice(budget, max_calls)
+    token = _CALL_SLICES.set((*_CALL_SLICES.get(), frame))
+    try:
+        yield frame
+    finally:
+        with budget._lock:
+            frame.closed = True
+        _CALL_SLICES.reset(token)
