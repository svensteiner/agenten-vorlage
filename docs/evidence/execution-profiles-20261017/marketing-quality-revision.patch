+def _real_quality_retry_bot(tmp_path, monkeypatch, *, gatekeeper_answers,
+                            auditor_answers=None, source_reject=False, call_status="ok",
+                            observation=None, drafts=None):
+    """Actual news generator, source qualifier, auditor, and gatekeeper; fake provider only."""
+    import json
+    from unittest.mock import Mock
+    from intelligent_features.content_gatekeeper import ContentGatekeeper
+
+    observation = observation or (
+        "Seven scans are missing. Loading status is unknown. A supervisor must approve closeout."
+    )
+    first = "Sieben Scans fehlen; Ladestatus unbekannt. Abschluss erst nach Freigabe durch eine Aufsichtsperson."
+    revised = "Sieben Scans fehlen; der Ladestatus bleibt unklar. Abschluss nur nach Freigabe durch die Aufsichtsperson."
+    drafts = list(drafts or [first, revised])
+    first, revised = drafts[0], drafts[1] if len(drafts) > 1 else drafts[0]
+    gatekeeper_answers = list(gatekeeper_answers)
+    auditor_answers = list(auditor_answers or ["STRONG", "STRONG"])
+
+    class BudgetedResponder:
+        def __init__(self):
+            self.calls = []
+            self.completed = []
+            self.generated = []
+
+        def generate_freeform(self, user_prompt, system_prompt=None, context=None):
+            context = context or {}
+            self.calls.append((user_prompt, system_prompt or "", dict(context)))
+            active = budgets.current_budget()
+            if active is not None:
+                attempt_id = active.reserve("offline-test", "synthetic")
+                active.record(attempt_id, usage={"total_tokens": 1}, status=call_status)
+                self.completed.append(attempt_id)
+            task_type = context.get("task_type")
+            if task_type == "source_faithfulness_review":
+                if source_reject:
+                    return json.dumps({"verdict": "reject", "issues": ["format"],
+                        "claims": [], "human_controls_preserved": False,
+                        "uncertainty_preserved": False})
+                draft_line = next(line[len("DRAFT_JSON: "):] for line in user_prompt.splitlines()
+                                  if line.startswith("DRAFT_JSON: "))
+                source_line = next(line[len("SOURCE_JSON: "):] for line in user_prompt.splitlines()
+                                   if line.startswith("SOURCE_JSON: "))
+                draft = json.loads(draft_line)["text"]
+                source = json.loads(source_line)["observation"]
+                return json.dumps({"verdict": "accept", "issues": [], "claims": [
+                    {"draft_span": draft, "source_quote": source, "kind": "inference"}],
+                    "human_controls_preserved": True, "uncertainty_preserved": True})
+            if "Audit this tweet:" in user_prompt:
+                verdict = auditor_answers.pop(0)
+                failure_mode = "Vague" if verdict == "WEAK" else "NONE"
+                return json.dumps({"Verdict": verdict, "Primary Failure Mode": failure_mode,
+                    "Why It Would / Would Not Perform": "PRIVATE_AUDITOR_REASON_MUST_NOT_FEED_RETRY"})
+            if "VERDICT-ONLY FUER STANDALONE-POSTS" in system_prompt:
+                answer = gatekeeper_answers.pop(0)
+                if answer == "invalid":
+                    return "PRIVATE_GATE_RESPONSE_WITHOUT_A_VERDICT"
+                status = "APPROVED" if answer == "approved" else "REJECTED"
+                reason = "PRIVATE_GATE_REASON_MUST_NOT_FEED_RETRY"
+                return f"STATUS: {status}\nTYPE: AUTHORITY\nSCORE: 9\nREASON: {reason}"
+            draft = drafts.pop(0)
+            self.generated.append(draft)
+            return draft
