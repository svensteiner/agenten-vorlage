+class TaskCallSlice:
+    """A context-local physical-call cap sharing the parent identity/accounting.
+
+    Capacity checks do not reserve future slots. Provider fallbacks still use
+    reserve(), so they cannot bypass the local or parent limits.
+    """
+
+    def __init__(self, budget: TaskBudget, max_calls: int) -> None:
+        if not _valid_limit(max_calls):
+            raise BudgetExceeded("Invalid local LLM call limit")
+        self.budget = budget
+        self.max_calls = max_calls
+        self.attempt_ids: set[str] = set()
+        self.exhausted = False
+        self.closed = False
+
+    def can_reserve(self, count: int) -> bool:
+        with self.budget._lock:
+            if (not _valid_limit(count) or self.closed or self.exhausted
+                    or self not in _CALL_SLICES.get() or current_budget() is not self.budget
+                    or self.budget.exhausted or not _valid_limit(self.budget.max_calls)
+                    or len(self.budget.attempts) + count > self.budget.max_calls):
+                return False
+            inference_limit = self.budget.max_inference_calls
+            if inference_limit is not None and (
+                not _valid_limit(inference_limit)
+                or self.budget._inference_calls + count > inference_limit
+            ):
+                return False
+            return all(
+                not frame.closed and not frame.exhausted
+                and len(frame.attempt_ids) + count <= frame.max_calls
+                for frame in _CALL_SLICES.get() if frame.budget is self.budget
+            )
+
+    def calls_completed_ok(self) -> bool:
