+@pytest.mark.parametrize("tone", list(TonePreset))
+def test_source_bounded_generation_uses_real_tone_without_legacy_demands(tone):
+    from content.tweet_archetypes import get_tone_instruction
+    llm = MagicMock()
+    llm.generate_freeform.return_value = "Die Ladung hat 12 Tonnen."
+    generator = TensionGenerator(llm_responder=llm)
+    observation = "Die Ladung hat 12 Tonnen. Kontrolle ausstehend; Freigabe durch Mara erforderlich."
+    # Select a real preset; do not replace its real instruction with a fixture.
+    with patch("content.tweet_archetypes.select_tone", return_value=tone):
+        assert generator.generate(observation, max_chars=190) == "Die Ladung hat 12 Tonnen."
+    call = llm.generate_freeform.call_args.kwargs
+    assert get_tone_instruction(tone) not in call["system_prompt"]
+    assert "Tone: " + tone.value in call["system_prompt"]
+    assert "12 Tonnen" in call["user_prompt"]
+    assert "Mara" in call["user_prompt"]
+
+
+@pytest.mark.parametrize("tone", list(TonePreset))
+def test_unbounded_generation_keeps_each_real_legacy_tone(tone):
+    from content.tweet_archetypes import get_tone_instruction
+    llm = MagicMock()
+    llm.generate_freeform.return_value = "Die Ladung hat 12 Tonnen."
+    with patch("content.tweet_archetypes.select_tone", return_value=tone):
+        assert TensionGenerator(llm_responder=llm).generate("Die Ladung hat 12 Tonnen.")
+    assert get_tone_instruction(tone) in llm.generate_freeform.call_args.kwargs["system_prompt"]
